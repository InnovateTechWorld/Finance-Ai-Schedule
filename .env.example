# ── Model ──────────────────────────────────────────────────────────────────
# Either works. Bedrock bearer takes precedence when both are set.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Sonnet 5 is only invokable through a cross-region inference profile, so the
# geo prefix (us. / eu. / apac. / au. / jp. / global.) is derived from AWS_REGION
# and prepended automatically. Set BEDROCK_MODEL_ID only to override — a bare id
# gets prefixed, an already-prefixed id or a profile ARN is used as-is.
# Confirm yours: aws bedrock list-inference-profiles --region <region>
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# BEDROCK_INFERENCE_GEO=us

# Thinking is disabled by default — extraction is transcription, not reasoning,
# and it is most of the latency. Set to "adaptive" if quality ever slips.
MODEL_THINKING=off

# First-party fallback (used when AWS_BEARER_TOKEN_BEDROCK is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5

# ── Code sandbox (execute_code) ────────────────────────────────────────────
# Key is the HTTP Basic username, empty password.
AGENT_V2_CODE_BASEURL=https://<API_KEY>@sandbox.wekoya.tech

# ── File converter (convert_file) ──────────────────────────────────────────
FILE_CONVERT_API_URL=https://sandbox.wekoya.tech
FILE_CONVERT_API_KEY=
FILE_CONVERT_MAX_BYTES=52428800
FILE_CONVERT_TIMEOUT_MS=60000
